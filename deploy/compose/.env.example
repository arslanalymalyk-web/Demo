# Copy to .env. None of these is a secret. Secrets go in ./secrets (see secrets/README.md).
SERVER_NAME=tigeris.client.example
TIGERIS_INSTITUTION_ID=            # created by the first migration and seed; see the runbook
OIDC_ISSUER=https://idp.client.example/realms/main
OIDC_AUDIENCE=tigeris-api
OIDC_JWKS_URI=https://idp.client.example/realms/main/protocol/openid-connect/certs
OIDC_AUTHORITY=https://idp.client.example/realms/main
OIDC_CLIENT_ID=tigeris-web
# Every outbound connection goes through the egress proxy, which allows only these host:port pairs and nothing else. List the identity provider (its keys are fetched through it),
# each public data source the scheduler may fetch, the model host if one is connected, and the mail relay. An institution-internal host also goes in EGRESS_ALLOW_PRIVATE.
EGRESS_ALLOW=idp.client.example:443
EGRESS_ALLOW_PRIVATE=
# Sessions are honoured for at most this long after the identity provider issued the token (seconds; 0 turns the limit off).
OIDC_MAX_TOKEN_AGE_SECONDS=28800
# Emergency sign-in: the public half of the key made by `identity break-glass init` (the two private shares are held by two different people).
# TIGERIS_BREAKGLASS_PUBLIC_KEY=
BACKUP_DIR=/srv/tigeris/backups     # a different disk or host from the database volume
LOG_LEVEL=info
# Institution documents stay off until the client's own security review is complete (decision 11).
TIGERIS_CLIENT_DATA_ENABLED=false
TIGERIS_CLIENT_DATA_REVIEW_DONE=false
# Reasoning (the Assistant) is off until the client chooses a model. Only public-record, sample and scenario data is ever sent.
TIGERIS_REASONING_PROVIDER=off
# TIGERIS_MODEL_NAME=
# TIGERIS_MODEL_BASE_URL=            # required for openai_compatible; anthropic defaults to https://api.anthropic.com
# TIGERIS_MODEL_API_KEY_FILE=/run/secrets/model_api_key
# Scheduled ingestion is off until the client enables it and a schedule is activated in Settings (two administrators).
TIGERIS_SCHEDULER_ENABLED=false
# TIGERIS_SCHEDULER_TICK_SECONDS=60
# Malware scanning of uploads. Required for institution documents. Start the scanner with: docker compose --profile scanner up -d
TIGERIS_SCANNER=off
# TIGERIS_SCANNER=clamav
# CLAMAV_IMAGE=clamav/clamav:1.4@sha256:...   # the compose file pins a digest already
# Alerts by email through the client's own mail relay (off until configured). The password goes in TIGERIS_SMTP_PASSWORD_FILE.
TIGERIS_ALERTS_ENABLED=false
# TIGERIS_SMTP_HOST=relay.institution.example
# TIGERIS_SMTP_PORT=587
# TIGERIS_SMTP_SECURITY=starttls     # starttls or tls; none is refused in production
# TIGERIS_SMTP_USER=
# TIGERIS_ALERTS_FROM="TIGERIS <alerts@institution.example>"
# TIGERIS_WEB_BASE_URL=https://tigeris.institution.example
# TIGERIS_ALERTS_REMINDER_HOURS=24
# TIGERIS_ALERTS_MAX_PER_HOUR=120
