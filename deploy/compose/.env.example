# Copy to .env. None of these is a secret. Secrets go in ./secrets (see secrets/README.md).
SERVER_NAME=tigeris.client.example
TIGERIS_INSTITUTION_ID=            # created by the first migration and seed; see the runbook
OIDC_ISSUER=https://idp.client.example/realms/main
OIDC_AUDIENCE=tigeris-api
OIDC_JWKS_URI=https://idp.client.example/realms/main/protocol/openid-connect/certs
OIDC_AUTHORITY=https://idp.client.example/realms/main
OIDC_CLIENT_ID=tigeris-web
BACKUP_DIR=/srv/tigeris/backups     # a different disk or host from the database volume
LOG_LEVEL=info
# Institution documents stay off until the client's own security review is complete (decision 11).
TIGERIS_CLIENT_DATA_ENABLED=false
TIGERIS_CLIENT_DATA_REVIEW_DONE=false
