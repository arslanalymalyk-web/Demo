# Variables filled at start: SERVER_NAME, OIDC_AUTHORITY_ORIGIN (for example https://idp.client.example), API_UPSTREAM (default http://app:3000)
# The security headers live in security_headers.inc, rendered from its own template, and are included in each location that sets other headers.
server {
  listen 8080;
  server_name _;
  # Plain HTTP only redirects. Certificates are mounted at /etc/nginx/tls (tls.crt, tls.key).
  location = /healthz { access_log off; return 200 "ok\n"; }
  location / { return 301 https://$host$request_uri; }
}

server {
  listen 8443 ssl;
  http2 on;
  server_name ${SERVER_NAME};

  ssl_certificate /etc/nginx/tls/tls.crt;
  ssl_certificate_key /etc/nginx/tls/tls.key;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_timeout 1d;
  ssl_session_cache shared:SSL:10m;
  ssl_session_tickets off;

  include /etc/nginx/conf.d/security_headers.inc;

  root /usr/share/nginx/html;
  index index.html;
  client_max_body_size 2m;
  resolver 127.0.0.11 valid=10s ipv6=off;
  set $upstream ${API_UPSTREAM};

  # Operations endpoints are for the internal network only.
  location ^~ /api/metrics { return 404; }

  location = /api/v1/documents {
    limit_req zone=uploads burst=5 nodelay;
    client_max_body_size 22m;
    proxy_request_buffering on;
    proxy_read_timeout 300s;
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass $upstream;
    include /etc/nginx/proxy_params.conf;
  }

  location /api/ {
    limit_req zone=api burst=60 nodelay;
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass $upstream;
    proxy_read_timeout 120s;
    include /etc/nginx/proxy_params.conf;
  }

  location = /config.js { include /etc/nginx/conf.d/security_headers.inc; add_header Cache-Control "no-store" always; try_files $uri =404; }
  location /assets/ { include /etc/nginx/conf.d/security_headers.inc; add_header Cache-Control "public, max-age=31536000, immutable" always; try_files $uri =404; }
  location ~ /\. { return 404; }
  location / { include /etc/nginx/conf.d/security_headers.inc; add_header Cache-Control "no-cache" always; try_files $uri /index.html; }
}
