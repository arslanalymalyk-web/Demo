# Copy to .env (never commit .env). Create the databases with scripts/bootstrap-db.sh.
DATABASE_URL_OWNER=postgres://tigeris_owner:CHANGE_ME@localhost:5432/tigeris
DATABASE_URL=postgres://tigeris_app:CHANGE_ME@localhost:5432/tigeris
DATABASE_URL_TEST_OWNER=postgres://tigeris_owner:CHANGE_ME@localhost:5432/tigeris_test
DATABASE_URL_TEST=postgres://tigeris_app:CHANGE_ME@localhost:5432/tigeris_test
TIGERIS_INSTITUTION_ID=
# Identity provider (the API does not start without these)
OIDC_ISSUER=
OIDC_AUDIENCE=tigeris-api
OIDC_JWKS_URI=
# Institution documents stay off until the client's security review is complete
TIGERIS_CLIENT_DATA_ENABLED=false
# Reasoning (the Assistant) is off until the client chooses a model. Only public-record, sample and scenario data is ever sent.
TIGERIS_REASONING_PROVIDER=off
# TIGERIS_MODEL_NAME=
# TIGERIS_MODEL_BASE_URL=            # required for openai_compatible; anthropic defaults to https://api.anthropic.com
# TIGERIS_MODEL_API_KEY_FILE=/run/secrets/model_api_key
